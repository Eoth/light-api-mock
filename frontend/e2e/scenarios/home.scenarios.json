{
  "domain": "home",
  "scenarios": [
    {
      "scenario": "La page d'accueil se charge avec le titre Mimicway",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "assertText", "target": "app.titleButton", "value": "Mimicway" }
      ]
    },
    {
      "scenario": "Charger le service de demo depuis la liste vide",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.loadDemoButton" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "users-api" } },
        { "action": "assertHidden", "target": "notification.notification" },
        { "action": "screenshot", "file": "home-service-list.png", "target": ["serviceCard.card", "urlHealthBadge.testButton"], "params": { "name": "users-api", "serviceName": "users-api" } }
      ]
    }
  ]
}
