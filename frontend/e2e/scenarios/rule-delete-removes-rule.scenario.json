    { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "e2e-svc" } },
    { "action": "click", "target": "ruleList.deleteButton", "params": { "name": "rule-alpha" } },
    { "action": "assertHidden", "target": "ruleList.item", "params": { "name": "rule-alpha" } },
    { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "rule-beta" } }
  ]
}
