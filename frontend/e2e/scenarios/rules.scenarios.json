{
  "domain": "rules",
  "scenarios": [
    {
      "scenario": "Creer une regle simple sur un service existant",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "scenario-rule-svc" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "fill", "target": "ruleForm.nameInput", "value": "scenario-simple-rule" },
        { "action": "screenshot", "file": "regle-formulaire-creation.png" },
        { "action": "click", "target": "ruleForm.submitButton" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "scenario-simple-rule" } }
      ]
    },
    {
      "scenario": "Afficher les regles existantes d'un service",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "e2e-svc" } },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "rule-alpha" } },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "rule-beta" } }
      ]
    },
    {
      "scenario": "Le bouton Ajouter une regle fonctionne quand des regles existent deja",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "e2e-svc" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "assertVisible", "target": "ruleForm.nameInput" }
      ]
    },
    {
      "scenario": "Le bouton Modifier (crayon) ouvre le formulaire de la regle",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "e2e-svc" } },
        { "action": "click", "target": "ruleList.editButton", "params": { "name": "rule-alpha" } },
        { "action": "assertVisible", "target": "ruleForm.nameInput" }
      ]
    },
    {
      "scenario": "Le bouton Supprimer retire la regle de la liste",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "e2e-svc" } },
        { "action": "click", "target": "ruleList.deleteButton", "params": { "name": "rule-alpha" } },
        { "action": "assertHidden", "target": "ruleList.item", "params": { "name": "rule-alpha" } },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "rule-beta" } }
      ]
    },
    {
      "scenario": "Annuler le formulaire de regle revient a la liste",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "e2e-svc" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "assertVisible", "target": "ruleForm.nameInput" },
        { "action": "click", "target": "ruleForm.cancelButton" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "rule-alpha" } }
      ]
    },
    {
      "scenario": "Une regle qui chevauche une regle existante declenche un avertissement de conflit",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "conflict-svc" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "fill", "target": "ruleForm.nameInput", "value": "conflict-rule-two" },
        { "action": "click", "target": "ruleForm.submitButton" },
        { "action": "assertVisible", "target": "ruleForm.conflictWarning" },
        { "action": "assertVisible", "target": "ruleForm.conflictWarningItem", "params": { "name": "conflict-rule-one" } },
        { "action": "screenshot", "file": "regle-avertissement-conflit.png" }
      ]
    },
    {
      "scenario": "Une regle qui ne chevauche aucune regle existante ne declenche aucun avertissement",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "conflict-svc" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "fill", "target": "ruleForm.nameInput", "value": "conflict-rule-different-method" },
        { "action": "selectOption", "target": "ruleForm.methodSelect", "value": "POST" },
        { "action": "click", "target": "ruleForm.submitButton" },
        { "action": "assertHidden", "target": "ruleForm.conflictWarning" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "conflict-rule-different-method" } }
      ]
    },
    {
      "scenario": "Enregistrer quand meme malgre l'avertissement de conflit fonctionne",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "conflict-svc" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "fill", "target": "ruleForm.nameInput", "value": "conflict-rule-two" },
        { "action": "click", "target": "ruleForm.submitButton" },
        { "action": "assertVisible", "target": "ruleForm.conflictWarning" },
        { "action": "click", "target": "ruleForm.conflictSaveAnywayButton" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "conflict-rule-two" } }
      ]
    },
    {
      "scenario": "L'action Proxy est absente pour une regle d'un service purement mocke",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "purely-mocked-for-rule" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "assertVisible", "target": "ruleForm.actionMockOption" },
        { "action": "assertHidden", "target": "ruleForm.actionProxyOption" },
        { "action": "assertVisible", "target": "ruleForm.purelyMockedHint" }
      ]
    },
    {
      "scenario": "Modifier une regle proxy heritee sur un service purement mocke affiche un avertissement avant sauvegarde",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "purely-mocked-stale-proxy" } },
        { "action": "click", "target": "ruleList.editButton", "params": { "name": "stale-proxy-rule" } },
        { "action": "fill", "target": "ruleForm.subpathInput", "value": "/updated" },
        { "action": "click", "target": "ruleForm.submitButton" },
        { "action": "assertVisible", "target": "ruleForm.staleProxyWarning" },
        { "action": "click", "target": "ruleForm.staleProxySaveAnywayButton" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "stale-proxy-rule" } }
      ]
    }
  ]
}
