    {
      "scenario": "Configurer une regle qui repete un element de reponse par element de la requete (illustration doc)",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "repeat-pattern-svc" } },
        { "action": "click", "target": "ruleList.addButton" },
        { "action": "fill", "target": "ruleForm.nameInput", "value": "calcul-devis" },
        { "action": "selectOption", "target": "ruleForm.methodSelect", "value": "POST" },
        { "action": "click", "target": "toggleSwitch.switch", "params": { "label": "Script-personnalise" } },
        { "action": "fill", "target": "rhaiScriptEditor.textarea", "params": { "id": "rule-script" }, "value": "let req = parse_json(request.body);\nlet lines = req.lines;\nlet out = [];\nfor line in lines {\n    let unit_price = seeded_int(line.sku, 10, 500);\n    out.push(#{\n        sku: line.sku,\n        qty: line.qty,\n        unitPrice: unit_price,\n        lineTotal: unit_price * line.qty\n    });\n}\n#{\n    count: out.len(),\n    lines_json: to_json(out)\n}" },
        { "action": "click", "target": "ruleForm.modeButton", "params": { "mode": "advanced" } },
        { "action": "click", "target": "ruleForm.fragmentAddButton" },
        { "action": "selectOption", "target": "ruleForm.fragmentTypeSelect", "params": { "idx": "0" }, "value": "Template" },
        { "action": "fill", "target": "ruleForm.fragmentTemplateTextarea", "params": { "idx": "0" }, "value": "{\"count\":{{script.count}},\"lines\":{{script.lines_json}}}" },
        { "action": "screenshot", "file": "regle-script-repetition-json.png" },
        { "action": "click", "target": "ruleForm.submitButton" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "calcul-devis" } }
      ]
    },
