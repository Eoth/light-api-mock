{
  "domain": "groups",
  "scenarios": [
    {
      "scenario": "Open the groups page from the navigation bar",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.navGroupsButton" },
        { "action": "assertVisible", "target": "groupManager.newGroupButton" }
      ]
    },
    {
      "scenario": "Create a group from its name alone",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.navGroupsButton" },
        { "action": "click", "target": "groupManager.newGroupButton" },
        { "action": "assertVisible", "target": "groupManager.nameInput" },
        { "action": "screenshot", "file": "group-create-form.png", "target": "groupManager.createForm" },
        { "action": "fill", "target": "groupManager.nameInput", "value": "ui-simple-group" },
        { "action": "click", "target": "groupManager.createSubmitButton" },
        { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "ui-simple-group" } }
      ]
    },
    {
      "scenario": "Create a group whose name holds accents and spaces",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.navGroupsButton" },
        { "action": "click", "target": "groupManager.newGroupButton" },
        { "action": "fill", "target": "groupManager.nameInput", "value": "Équipe Café Paris" },
        { "action": "click", "target": "groupManager.createSubmitButton" },
        { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "Équipe Café Paris" } }
      ]
    },
    {
      "scenario": "Create three groups in a row without a code collision",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.navGroupsButton" },
        { "action": "click", "target": "groupManager.newGroupButton" },
        { "action": "fill", "target": "groupManager.nameInput", "value": "collision-a" },
        { "action": "click", "target": "groupManager.createSubmitButton" },
        { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "collision-a" } },
        { "action": "click", "target": "groupManager.newGroupButton" },
        { "action": "fill", "target": "groupManager.nameInput", "value": "collision-b" },
        { "action": "click", "target": "groupManager.createSubmitButton" },
        { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "collision-b" } },
        { "action": "click", "target": "groupManager.newGroupButton" },
        { "action": "fill", "target": "groupManager.nameInput", "value": "collision-c" },
        { "action": "click", "target": "groupManager.createSubmitButton" },
        { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "collision-c" } }
      ]
    },
    {
      "scenario": "An expanded group stays expanded after opening one of its services",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "persist-grp" } },
        { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "persist-svc" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "persist-svc" } },
        { "action": "assertVisible", "target": "serviceDetail.editButton" },
        { "action": "click", "target": "serviceDetail.backButton" },
        { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "persist-svc" } }
      ]
    },
    {
      "scenario": "Reloading the page collapses an expanded group",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "reload-grp" } },
        { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "reload-svc" } },
        { "action": "goto", "page": "services" },
        { "action": "assertHidden", "target": "serviceCard.card", "params": { "name": "reload-svc" } }
      ]
    }
  ]
}
