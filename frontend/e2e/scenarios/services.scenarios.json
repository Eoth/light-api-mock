{
  "domain": "services",
  "scenarios": [
    {
      "scenario": "Creer un service via le formulaire",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.addServiceButton" },
        { "action": "fill", "target": "serviceForm.nameInput", "value": "scenario-create-service" },
        { "action": "fill", "target": "serviceForm.targetInput", "value": "http://scenario-create-service:80" },
        { "action": "screenshot", "file": "service-create-form.png" },
        { "action": "click", "target": "serviceForm.submitButton" },
        { "action": "assertVisible", "target": "serviceDetail.editButton" },
        { "action": "screenshot", "file": "service-detail-url.png" }
      ]
    },
    {
      "scenario": "The service form offers the SOAP type",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.addServiceButton" },
        { "action": "fill", "target": "serviceForm.nameInput", "value": "customer-directory" },
        { "action": "fill", "target": "serviceForm.targetInput", "value": "http://directory.internal:8080" },
        { "action": "selectOption", "target": "serviceForm.typeSelect", "value": "soap" },
        { "action": "screenshot", "file": "service-form-soap.png" },
        { "action": "click", "target": "serviceForm.cancelButton" },
        { "action": "assertVisible", "target": "app.addServiceButton" }
      ]
    },
    {
      "scenario": "La liste affiche un service cree via l'API dans son groupe",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "ui-test-svc" } }
      ]
    },
    {
      "scenario": "La recherche filtre les services et affiche un message si aucun resultat",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "fill", "target": "serviceList.searchInput", "value": "xyz-unique" },
        { "action": "assertVisible", "target": "serviceList.noResultsMessage" }
      ]
    },
    {
      "scenario": "Le toggle mock/proxy d'un service fonctionne",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "toggleSwitch.switch", "params": { "name": "mock-e2e-svc" } }
      ]
    },
    {
      "scenario": "Basculer le mode mock/proxy d'un service via l'UI",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "toggleSwitch.switch", "params": { "name": "mock-write-behind-svc" } }
      ]
    },
    {
      "scenario": "Supprimer un service dans un groupe ne supprime pas son homonyme d'un autre groupe",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ambig-grp-a" } },
        { "action": "screenshot", "file": "groups-collapsed-expanded.png" },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "ambig-svc" } },
        { "action": "click", "target": "serviceDetail.deleteButton" },
        { "action": "click", "target": "confirmDialog.confirmButton" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ambig-grp-b" } },
        { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "ambig-svc" } }
      ]
    },
    {
      "scenario": "Supprimer un service n'affiche pas de fausse erreur apres le succes",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "no-crash-svc" } },
        { "action": "click", "target": "serviceDetail.deleteButton" },
        { "action": "click", "target": "confirmDialog.confirmButton" },
        { "action": "assertText", "target": "notification.notification", "value": "deleted" }
      ]
    },
    {
      "scenario": "Le service mocke type INSEE est visible dans la liste UI",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "tpl-test" } }
      ]
    },
    {
      "scenario": "Creer un service purement mocke via le formulaire",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "app.addServiceButton" },
        { "action": "fill", "target": "serviceForm.nameInput", "value": "purely-mocked-svc" },
        { "action": "click", "target": "toggleSwitch.switch", "params": { "name": "purely-mocked" } },
        { "action": "assertHidden", "target": "serviceForm.targetInput" },
        { "action": "screenshot", "file": "service-purely-mocked-form.png" },
        { "action": "click", "target": "serviceForm.submitButton" },
        { "action": "assertVisible", "target": "serviceDetail.editButton" },
        { "action": "assertHidden", "target": "urlHealthBadge.status", "params": { "serviceName": "purely-mocked-svc" } }
      ]
    },
    {
      "scenario": "Decocher purement mocke reaffiche la cible sans perte des regles",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "purely-mocked-existing" } },
        { "action": "click", "target": "serviceDetail.editButton" },
        { "action": "assertHidden", "target": "serviceForm.targetInput" },
        { "action": "click", "target": "toggleSwitch.switch", "params": { "name": "purely-mocked" } },
        { "action": "assertVisible", "target": "serviceForm.targetInput" },
        { "action": "fill", "target": "serviceForm.targetInput", "value": "http://nouvelle-cible:8080" },
        { "action": "click", "target": "serviceForm.submitButton" },
        { "action": "assertVisible", "target": "ruleList.item", "params": { "name": "existing-rule" } }
      ]
    },
    {
      "scenario": "Bascule a posteriori vers purement mocke avec une regle Proxy existante affiche un avertissement",
      "steps": [
        { "action": "goto", "page": "services" },
        { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "ungrouped" } },
        { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "svc-with-proxy-rule" } },
        { "action": "click", "target": "serviceDetail.editButton" },
        { "action": "click", "target": "toggleSwitch.switch", "params": { "name": "purely-mocked" } },
        { "action": "click", "target": "serviceForm.submitButton" },
        { "action": "assertVisible", "target": "serviceForm.purelyMockedWarning" },
        { "action": "click", "target": "serviceForm.purelyMockedSaveAnywayButton" },
        { "action": "assertVisible", "target": "serviceDetail.editButton" },
        { "action": "assertHidden", "target": "urlHealthBadge.status", "params": { "serviceName": "svc-with-proxy-rule" } }
      ]
    }
  ]
}
