{
  "scenario": "Creer plusieurs groupes a la suite ne bloque jamais sur une collision de code",
  "steps": [
    { "action": "goto", "page": "services" },
    { "action": "click", "target": "app.navGroupsButton" },
    { "action": "click", "target": "groupManager.newGroupButton" },
    { "action": "fill", "target": "groupManager.nameInput", "value": "collision-a" },
    { "action": "click", "target": "groupManager.createSubmitButton" },
    { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "collision-a" } },
    { "action": "click", "target": "groupManager.newGroupButton" },
    { "action": "fill", "target": "groupManager.nameInput", "value": "collision-b" },
    { "action": "click", "target": "groupManager.createSubmitButton" },
    { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "collision-b" } },
    { "action": "click", "target": "groupManager.newGroupButton" },
    { "action": "fill", "target": "groupManager.nameInput", "value": "collision-c" },
    { "action": "click", "target": "groupManager.createSubmitButton" },
    { "action": "assertVisible", "target": "groupManager.card", "params": { "name": "collision-c" } }
  ]
}
