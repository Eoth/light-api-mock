{
  "scenario": "Un groupe deplie reste visible apres retour depuis l'edition d'un service",
  "steps": [
    { "action": "goto", "page": "services" },
    { "action": "click", "target": "serviceGroup.header", "params": { "groupId": "persist-grp" } },
    { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "persist-svc" } },
    { "action": "click", "target": "serviceCard.configureButton", "params": { "name": "persist-svc" } },
    { "action": "assertVisible", "target": "serviceDetail.editButton" },
    { "action": "click", "target": "serviceDetail.backButton" },
    { "action": "assertVisible", "target": "serviceCard.card", "params": { "name": "persist-svc" } }
  ]
}
