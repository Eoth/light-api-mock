# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# The release image, assembled by .github/workflows/release.yml from the static Linux binaries it built and attested,
# on the same base and with the same settings as the Dockerfile. There is no RUN step, so the arm64 image needs no
# emulation to build.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
ARG TARGETARCH
COPY --chown=1000:1000 data /data
COPY --chmod=0755 linux-${TARGETARCH}/mimicway /app/mimicway
WORKDIR /app
USER 1000:1000
ENV DATA_PATH=/data PORT=7342 BIND_ADDRESS=0.0.0.0
EXPOSE 7342
ENTRYPOINT ["/app/mimicway"]
